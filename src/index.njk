<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.page_title }}</title>
<meta name="description" content="{{ site.meta_description }}">
<meta property="og:title" content="{{ site.og_title }}">
<meta property="og:description" content="{{ site.og_description }}">
<meta property="og:image" content="{{ site.og_image }}">
<link rel="icon" href="{{ site.logo }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header>
  <div class="wrap nav">
    <a class="brand" href="#top"><img src="{{ site.logo }}" alt="{{ site.brand }}"><span>{{ site.brand }}</span></a>
    <ul>
      {% for item in nav %}<li><a href="{{ item.href }}">{{ item.label }}</a></li>{% endfor %}
    </ul>
    <a class="btn" href="{{ nav_cta_href }}">{{ nav_cta_label }}</a>
  </div>
</header>

<div class="hero" id="top">
  <div class="wrap">
    <div>
      <p class="eyebrow">{{ hero.eyebrow }}</p>
      <h1>{{ hero.heading_before }}<em>{{ hero.heading_emphasis }}</em>{{ hero.heading_after }}</h1>
      <p class="lede">{{ hero.lede_1 }}</p>
      <p class="lede">{{ hero.lede_2 }}</p>
      <div class="cta">
        <a class="btn" href="{{ hero.cta_primary_href }}">{{ hero.cta_primary_label }}</a>
        <a class="btn ghost" href="{{ hero.cta_secondary_href }}">{{ hero.cta_secondary_label }}</a>
      </div>
      <p class="social-row">
        <span>Follow</span>
        {% for s in social %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.label }}</a>{% endfor %}
      </p>
    </div>
    <figure class="hero-fig">
      <img src="{{ hero.image }}" alt="{{ hero.image_alt }}">
      <figcaption>{{ hero.caption }}</figcaption>
    </figure>
  </div>
</div>

<section id="problem">
  <div class="wrap">
    <p class="eyebrow">{{ problem.eyebrow }}</p>
    <h2>{{ problem.heading }}</h2>
    <p class="kicker">{{ problem.kicker }}</p>
    <div class="grid three">
      {% for card in problem.cards %}
      <div class="card">
        <span class="tag">{{ card.tag }}</span>
        <h3>{{ card.title }}</h3>
        <p>{{ card.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="light" id="get">
  <div class="wrap">
    <p class="eyebrow">{{ get.eyebrow }}</p>
    <h2>{{ get.heading }}</h2>
    <p class="kicker">{{ get.kicker }}</p>
    <div class="grid three">
      {% for card in get.cards %}
      <div class="card">
        <span class="tag">{{ card.tag }}</span>
        <h3>{{ card.title }}</h3>
        <p>{{ card.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="light" id="measure" style="padding-top:0">
  <div class="wrap">
    <p class="eyebrow">{{ measure.eyebrow }}</p>
    <h2>{{ measure.heading }}</h2>
    <p class="kicker">{{ measure.kicker }}</p>
    <div class="dims">
      {% for d in measure.dims %}<div class="dim"><b>{{ d.title }}</b><span>{{ d.body }}</span></div>{% endfor %}
    </div>
  </div>
</section>

<section id="how">
  <div class="wrap">
    <p class="eyebrow">{{ how.eyebrow }}</p>
    <h2>{{ how.heading }}</h2>
    <ol class="steps">
      {% for step in how.steps %}<li><div><b>{{ step.title }}</b><p>{{ step.body }}</p></div></li>{% endfor %}
    </ol>
    <p class="kicker" style="margin-top:30px">{{ how.note }}</p>
  </div>
</section>

<section>
  <div class="wrap ecosystem">
    <img src="{{ ecosystem.image }}" alt="{{ ecosystem.image_alt }}">
    <div>
      <p class="eyebrow">{{ ecosystem.eyebrow }}</p>
      <h2>{{ ecosystem.heading }}</h2>
      <p class="kicker">{{ ecosystem.kicker }}</p>
      <div class="chips">
        {% for chip in ecosystem.chips %}<span class="chip">{{ chip }}</span>{% endfor %}
      </div>
    </div>
  </div>
</section>

<section id="young">
  <div class="wrap split">
    <div>
      <p class="eyebrow">{{ young.eyebrow }}</p>
      <h2>{{ young.heading }}</h2>
      <p class="kicker">{{ young.kicker }}</p>
      <div class="cta">
        <a class="btn" href="{{ young.cta_href }}">{{ young.cta_label }}</a>
      </div>
    </div>
    <img src="{{ young.image }}" alt="{{ young.image_alt }}">
  </div>
</section>

<section id="channels">
  <div class="wrap">
    <p class="eyebrow">{{ channels.eyebrow }}</p>
    <h2>{{ channels.heading }}</h2>
    <p class="kicker">{{ channels.kicker }}</p>
    <div class="grid three chan">
      {% for c in channels.items %}
      <a class="card link-card" href="{{ c.url }}" target="_blank" rel="noopener">
        <span class="tag">{{ c.tag }}</span>
        <h3>{{ c.title }}</h3>
        <p>{{ c.body }}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<div class="final" id="start">
  <div class="wrap">
    <p class="eyebrow">{{ final.eyebrow }}</p>
    <h2>{{ final.heading }}</h2>
    <p>{{ final.body }}</p>
    <a class="btn" href="{{ final.cta_href }}">{{ final.cta_label }}</a>
  </div>
</div>

<footer class="wrap">
  <div>{{ site.footer_line }}</div>
  <div class="foot-links">
    {% for s in social %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.label }}</a>{% if not loop.last %}<span>·</span>{% endif %}{% endfor %}
  </div>
</footer>

</body>
</html>
